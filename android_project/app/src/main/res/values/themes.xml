<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Strong_body" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gymeye_primary</item>
        <item name="colorPrimaryVariant">@color/gymeye_primary_dark</item>
        <item name="colorOnPrimary">@color/gymeye_on_primary</item>
        <item name="colorSecondary">@color/gymeye_accent</item>
        <item name="colorSecondaryVariant">@color/gymeye_accent_dark</item>
        <item name="colorOnSecondary">@color/gymeye_on_accent</item>
        <item name="colorAccent">@color/gymeye_accent</item>
        <item name="colorError">@color/gymeye_error</item>
        <item name="colorSurface">@color/gymeye_surface</item>
        <item name="colorOnSurface">@color/gymeye_text_primary</item>
        <item name="android:colorBackground">@color/gymeye_background</item>
        <item name="android:fontFamily">sans-serif</item>

        <item name="android:windowBackground">@color/gymeye_background</item>
        <item name="android:statusBarColor">@color/gymeye_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/gymeye_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>

        <item name="materialButtonStyle">@style/Widget.GymEye.MaterialButton</item>
        <item name="buttonStyle">@style/Widget.GymEye.Button</item>
        <item name="checkboxStyle">@style/Widget.GymEye.CheckBox</item>
    </style>

    <style name="Widget.GymEye.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/gymeye_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/gymeye_on_primary</item>
        <item name="android:textSize">@dimen/gymeye_text_body</item>
        <item name="backgroundTint">@color/gymeye_primary</item>
        <item name="cornerRadius">@dimen/gymeye_radius_button</item>
        <item name="elevation">2dp</item>
        <item name="rippleColor">@color/gymeye_accent_surface</item>
    </style>

    <style name="Widget.GymEye.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/gymeye_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/gymeye_on_primary</item>
        <item name="android:background">@drawable/bg_gymeye_button_primary</item>
    </style>

    <style name="Widget.GymEye.CheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="buttonTint">@color/gymeye_accent</item>
        <item name="android:textColor">@color/gymeye_text_primary</item>
    </style>

    <style name="TextAppearance.GymEye.Semibold" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/font_family</item>
        <item name="android:fontFamily">@font/font_family</item>
    </style>

    <style name="TextAppearance.GymEye.SemiboldSystem" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
</resources>
