<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gymeye_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gymeye_page_margin_horizontal"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/gymeye_page_margin_horizontal"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GymEye"
                android:textColor="@color/gymeye_text_primary"
                android:textSize="@dimen/gymeye_text_display"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gymeye_space_8"
                android:text="欢迎回来，开始今天的训练"
                android:textColor="@color/gymeye_text_primary"
                android:textSize="@dimen/gymeye_text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gymeye_space_4"
                android:text="扫描器械，获取动作指导"
                android:textColor="@color/gymeye_text_secondary"
                android:textSize="@dimen/gymeye_text_body" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="@dimen/gymeye_space_24"
            android:gravity="center"
            android:text="开始扫描器械"
            android:textAllCaps="false"
            android:textColor="@color/gymeye_on_primary"
            android:textSize="@dimen/gymeye_text_subtitle"
            android:textStyle="bold"
            app:backgroundTint="@color/gymeye_primary"
            app:cornerRadius="@dimen/gymeye_radius_card"
            app:elevation="3dp"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/gymeye_space_8"
            app:rippleColor="@color/gymeye_accent_surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gymeye_space_24"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="@dimen/gymeye_space_8"
                android:layout_weight="1"
                android:background="@drawable/bg_gymeye_card"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/gymeye_space_12">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="今日识别"
                    android:textColor="@color/gymeye_text_secondary"
                    android:textSize="@dimen/gymeye_text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_8"
                    android:text="8"
                    android:textColor="@color/gymeye_text_primary"
                    android:textSize="@dimen/gymeye_text_headline"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="次"
                    android:textColor="@color/gymeye_text_muted"
                    android:textSize="@dimen/gymeye_text_caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="@dimen/gymeye_space_4"
                android:layout_marginEnd="@dimen/gymeye_space_4"
                android:layout_weight="1"
                android:background="@drawable/bg_gymeye_card"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/gymeye_space_12">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="推荐训练"
                    android:textColor="@color/gymeye_text_secondary"
                    android:textSize="@dimen/gymeye_text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_8"
                    android:text="5"
                    android:textColor="@color/gymeye_text_primary"
                    android:textSize="@dimen/gymeye_text_headline"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="项"
                    android:textColor="@color/gymeye_text_muted"
                    android:textSize="@dimen/gymeye_text_caption" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="@dimen/gymeye_space_8"
                android:layout_weight="1"
                android:background="@drawable/bg_gymeye_card"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/gymeye_space_12">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已学器械"
                    android:textColor="@color/gymeye_text_secondary"
                    android:textSize="@dimen/gymeye_text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_8"
                    android:text="12"
                    android:textColor="@color/gymeye_text_primary"
                    android:textSize="@dimen/gymeye_text_headline"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="台"
                    android:textColor="@color/gymeye_text_muted"
                    android:textSize="@dimen/gymeye_text_caption" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gymeye_space_24"
            android:text="快捷入口"
            android:textColor="@color/gymeye_text_primary"
            android:textSize="@dimen/gymeye_text_subtitle"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gymeye_space_12"
            android:columnCount="2"
            android:rowCount="2">

            <TextView
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/gymeye_space_8"
                android:layout_marginBottom="@dimen/gymeye_space_12"
                android:background="@drawable/bg_gymeye_card"
                android:gravity="center"
                android:text="扫描识别"
                android:textColor="@color/gymeye_text_primary"
                android:textSize="@dimen/gymeye_text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="@dimen/gymeye_space_8"
                android:layout_marginBottom="@dimen/gymeye_space_12"
                android:background="@drawable/bg_gymeye_card"
                android:gravity="center"
                android:text="器械知识"
                android:textColor="@color/gymeye_text_primary"
                android:textSize="@dimen/gymeye_text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/gymeye_space_8"
                android:background="@drawable/bg_gymeye_card"
                android:gravity="center"
                android:text="训练记录"
                android:textColor="@color/gymeye_text_primary"
                android:textSize="@dimen/gymeye_text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="@dimen/gymeye_space_8"
                android:background="@drawable/bg_gymeye_card"
                android:gravity="center"
                android:text="我的收藏"
                android:textColor="@color/gymeye_text_primary"
                android:textSize="@dimen/gymeye_text_body"
                android:textStyle="bold" />
        </GridLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gymeye_button_height"
            android:layout_marginTop="@dimen/gymeye_space_24"
            android:text="退出登录"
            android:textAllCaps="false"
            android:textColor="@color/gymeye_text_secondary"
            android:textSize="@dimen/gymeye_text_body"
            app:cornerRadius="@dimen/gymeye_radius_button"
            app:strokeColor="@color/gymeye_border"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
