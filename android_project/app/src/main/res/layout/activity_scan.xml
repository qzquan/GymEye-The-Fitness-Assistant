<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gymeye_primary">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scan_camera_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scan_top_bar"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gymeye_space_16"
        android:paddingEnd="@dimen/gymeye_space_16"
        android:paddingBottom="@dimen/gymeye_space_12">

        <ImageButton
            android:id="@+id/btnScanBack"
            android:layout_width="@dimen/gymeye_touch_target"
            android:layout_height="@dimen/gymeye_touch_target"
            android:background="@drawable/circle_button_background"
            android:contentDescription="返回"
            android:padding="@dimen/gymeye_space_12"
            android:src="@drawable/ic_gymeye_arrow_back"
            app:tint="@color/gymeye_text_inverse" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gymeye_space_12"
            android:layout_weight="1"
            android:text="扫描识别"
            android:textColor="@color/gymeye_text_inverse"
            android:textSize="@dimen/gymeye_text_subtitle"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/gymeye_page_margin_horizontal"
        android:paddingEnd="@dimen/gymeye_page_margin_horizontal"
        android:paddingBottom="120dp">

        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="@drawable/bg_scan_focus_area">

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="start|top"
                android:background="@color/gymeye_accent" />

            <View
                android:layout_width="5dp"
                android:layout_height="44dp"
                android:layout_gravity="start|top"
                android:background="@color/gymeye_accent" />

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="end|top"
                android:background="@color/gymeye_accent" />

            <View
                android:layout_width="5dp"
                android:layout_height="44dp"
                android:layout_gravity="end|top"
                android:background="@color/gymeye_accent" />

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="start|bottom"
                android:background="@color/gymeye_accent" />

            <View
                android:layout_width="5dp"
                android:layout_height="44dp"
                android:layout_gravity="start|bottom"
                android:background="@color/gymeye_accent" />

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="end|bottom"
                android:background="@color/gymeye_accent" />

            <View
                android:layout_width="5dp"
                android:layout_height="44dp"
                android:layout_gravity="end|bottom"
                android:background="@color/gymeye_accent" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvScanTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gymeye_space_16"
            android:background="@drawable/bg_scan_tip_chip"
            android:paddingStart="@dimen/gymeye_space_16"
            android:paddingTop="@dimen/gymeye_space_8"
            android:paddingEnd="@dimen/gymeye_space_16"
            android:paddingBottom="@dimen/gymeye_space_8"
            android:text="将器械放入扫描框"
            android:textColor="@color/gymeye_text_inverse"
            android:textSize="@dimen/gymeye_text_label"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gymeye_bottom_panel"
        android:orientation="vertical"
        android:paddingStart="@dimen/gymeye_page_margin_horizontal"
        android:paddingTop="@dimen/gymeye_space_20"
        android:paddingEnd="@dimen/gymeye_page_margin_horizontal"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="识别结果"
            android:textColor="@color/gymeye_night_text_secondary"
            android:textSize="@dimen/gymeye_text_label" />

        <TextView
            android:id="@+id/tvDetectedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gymeye_space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="正在识别..."
            android:textColor="@color/gymeye_text_inverse"
            android:textSize="@dimen/gymeye_text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gymeye_space_8"
            android:background="@drawable/bg_scan_confidence_chip"
            android:paddingStart="@dimen/gymeye_space_12"
            android:paddingTop="@dimen/gymeye_space_4"
            android:paddingEnd="@dimen/gymeye_space_12"
            android:paddingBottom="@dimen/gymeye_space_4"
            android:text="置信度 --"
            android:textColor="@color/gymeye_text_inverse"
            android:textSize="@dimen/gymeye_text_label"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gymeye_button_height"
            android:layout_marginTop="@dimen/gymeye_space_16"
            android:text="查看器械详情"
            android:textAllCaps="false"
            android:textColor="@color/gymeye_on_accent"
            android:textSize="@dimen/gymeye_text_body"
            android:textStyle="bold"
            app:backgroundTint="@color/gymeye_accent"
            app:cornerRadius="@dimen/gymeye_radius_button"
            app:elevation="0dp"
            app:rippleColor="@color/gymeye_accent_surface" />
    </LinearLayout>
</FrameLayout>
