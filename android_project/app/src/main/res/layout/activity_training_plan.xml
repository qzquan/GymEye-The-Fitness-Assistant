<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gymeye_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/gymeye_space_24">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="248dp"
                android:background="@drawable/bg_gymeye_photo_hero"
                android:paddingStart="@dimen/gymeye_space_16"
                android:paddingTop="28dp"
                android:paddingEnd="@dimen/gymeye_space_16"
                android:paddingBottom="@dimen/gymeye_space_20">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/gymeye_touch_target"
                    android:layout_height="@dimen/gymeye_touch_target"
                    android:background="@drawable/circle_button_background"
                    android:contentDescription="返回"
                    android:padding="@dimen/gymeye_space_12"
                    android:src="@drawable/ic_gymeye_arrow_back"
                    app:tint="@color/gymeye_text_inverse" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_quick_icon_dark"
                        android:paddingStart="@dimen/gymeye_space_12"
                        android:paddingTop="@dimen/gymeye_space_4"
                        android:paddingEnd="@dimen/gymeye_space_12"
                        android:paddingBottom="@dimen/gymeye_space_4"
                        android:text="PROFILE BASED"
                        android:textColor="@color/gymeye_accent_mid"
                        android:textSize="@dimen/gymeye_text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_12"
                        android:text="训练计划"
                        android:textColor="@color/gymeye_on_primary"
                        android:textSize="@dimen/gymeye_text_headline"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_8"
                        android:lineSpacingExtra="3dp"
                        android:text="根据你的目标、水平和可用器械，生成今天能直接执行的训练安排。"
                        android:textColor="#DFFFFFFF"
                        android:textSize="@dimen/gymeye_text_body" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/profileForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gymeye_page_margin_horizontal"
                android:layout_marginTop="@dimen/gymeye_space_16"
                android:layout_marginEnd="@dimen/gymeye_page_margin_horizontal"
                android:background="@drawable/bg_gymeye_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="@dimen/gymeye_space_16"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStepLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="STEP 1 / 3"
                        android:textColor="@color/gymeye_accent_dark"
                        android:textSize="@dimen/gymeye_text_caption"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/stepDot1"
                            android:layout_width="28dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_plan_step_active" />

                        <View
                            android:id="@+id/stepDot2"
                            android:layout_width="28dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="@dimen/gymeye_space_4"
                            android:background="@drawable/bg_plan_step_inactive" />

                        <View
                            android:id="@+id/stepDot3"
                            android:layout_width="28dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="@dimen/gymeye_space_4"
                            android:background="@drawable/bg_plan_step_inactive" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStepTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_12"
                    android:text="基础身体信息"
                    android:textColor="@color/gymeye_text_primary"
                    android:textSize="@dimen/gymeye_text_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStepHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_4"
                    android:lineSpacingExtra="3dp"
                    android:text="填写用于估算训练强度的基础信息。"
                    android:textColor="@color/gymeye_text_secondary"
                    android:textSize="@dimen/gymeye_text_body" />

                <LinearLayout
                    android:id="@+id/stepBasic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_16"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="性别"
                        android:textColor="@color/gymeye_text_primary"
                        android:textSize="@dimen/gymeye_text_label"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSex"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_8"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_12"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/gymeye_space_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="身高 cm"
                                android:textColor="@color/gymeye_text_primary"
                                android:textSize="@dimen/gymeye_text_label"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etHeight"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/gymeye_input_height"
                                android:layout_marginTop="@dimen/gymeye_space_8"
                                android:background="@drawable/bg_gymeye_input_selector"
                                android:hint="175"
                                android:inputType="numberDecimal"
                                android:paddingStart="@dimen/gymeye_space_12"
                                android:paddingEnd="@dimen/gymeye_space_12"
                                android:singleLine="true"
                                android:textColor="@color/gymeye_text_primary"
                                android:textSize="@dimen/gymeye_text_body" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/gymeye_space_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="体重 kg"
                                android:textColor="@color/gymeye_text_primary"
                                android:textSize="@dimen/gymeye_text_label"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etWeight"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/gymeye_input_height"
                                android:layout_marginTop="@dimen/gymeye_space_8"
                                android:background="@drawable/bg_gymeye_input_selector"
                                android:hint="70"
                                android:inputType="numberDecimal"
                                android:paddingStart="@dimen/gymeye_space_12"
                                android:paddingEnd="@dimen/gymeye_space_12"
                                android:singleLine="true"
                                android:textColor="@color/gymeye_text_primary"
                                android:textSize="@dimen/gymeye_text_body" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stepGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_16"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="健身目标"
                        android:textColor="@color/gymeye_text_primary"
                        android:textSize="@dimen/gymeye_text_label"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupGoal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_8"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_16"
                        android:text="健身水平"
                        android:textColor="@color/gymeye_text_primary"
                        android:textSize="@dimen/gymeye_text_label"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_8"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_16"
                        android:text="每周训练次数"
                        android:textColor="@color/gymeye_text_primary"
                        android:textSize="@dimen/gymeye_text_label"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupWeekly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_8"
                        app:selectionRequired="true"
                        app:singleSelection="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stepEquipment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_16"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="当前可用器械"
                        android:textColor="@color/gymeye_text_primary"
                        android:textSize="@dimen/gymeye_text_label"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_4"
                        android:text="默认已选全部器械，可按实际可用情况调整。"
                        android:textColor="@color/gymeye_text_secondary"
                        android:textSize="@dimen/gymeye_text_label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupEquipment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_8"
                        app:singleSelection="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_20"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStepBack"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/gymeye_button_height"
                        android:layout_marginEnd="@dimen/gymeye_space_8"
                        android:layout_weight="1"
                        android:text="上一步"
                        android:textAllCaps="false"
                        android:textColor="@color/gymeye_text_primary"
                        app:cornerRadius="@dimen/gymeye_radius_button"
                        app:strokeColor="@color/gymeye_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStepNext"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/gymeye_button_height"
                        android:layout_marginStart="@dimen/gymeye_space_8"
                        android:layout_weight="1"
                        android:text="下一步"
                        android:textAllCaps="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/gymeye_button_height"
                        android:layout_marginStart="@dimen/gymeye_space_8"
                        android:layout_weight="1"
                        android:text="生成今日计划"
                        android:textAllCaps="false"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/planContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gymeye_page_margin_horizontal"
                android:layout_marginTop="@dimen/gymeye_space_16"
                android:layout_marginEnd="@dimen/gymeye_page_margin_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sport_panel_dark"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="@dimen/gymeye_space_16">

                    <TextView
                        android:id="@+id/tvPlanBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_quick_icon_dark"
                        android:paddingStart="@dimen/gymeye_space_12"
                        android:paddingTop="@dimen/gymeye_space_4"
                        android:paddingEnd="@dimen/gymeye_space_12"
                        android:paddingBottom="@dimen/gymeye_space_4"
                        android:text="今日计划"
                        android:textColor="@color/gymeye_accent_mid"
                        android:textSize="@dimen/gymeye_text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlanTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_12"
                        android:textColor="@color/gymeye_on_primary"
                        android:textSize="@dimen/gymeye_text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWeeklySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_8"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/gymeye_accent_mid"
                        android:textSize="@dimen/gymeye_text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRationale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_12"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#C9FFFFFF"
                        android:textSize="@dimen/gymeye_text_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_16"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenerate"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/gymeye_button_height"
                            android:layout_marginEnd="@dimen/gymeye_space_8"
                            android:layout_weight="1"
                            android:text="重新生成"
                            android:textAllCaps="false"
                            android:textColor="@color/gymeye_on_primary"
                            app:cornerRadius="@dimen/gymeye_radius_button"
                            app:strokeColor="#66FFFFFF" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditProfile"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/gymeye_button_height"
                            android:layout_marginStart="@dimen/gymeye_space_8"
                            android:layout_weight="1"
                            android:text="重新填写"
                            android:textAllCaps="false"
                            android:textColor="@color/gymeye_on_accent"
                            app:backgroundTint="@color/gymeye_accent"
                            app:cornerRadius="@dimen/gymeye_radius_button" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_20"
                    android:text="今日动作"
                    android:textColor="@color/gymeye_text_primary"
                    android:textSize="@dimen/gymeye_text_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlanEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_12"
                    android:background="@drawable/bg_equipment_empty"
                    android:gravity="center"
                    android:padding="@dimen/gymeye_space_20"
                    android:text="暂无训练动作"
                    android:textColor="@color/gymeye_text_muted"
                    android:textSize="@dimen/gymeye_text_body"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutPlanItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_12"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressPlan"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
