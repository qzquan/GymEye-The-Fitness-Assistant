<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_checkin_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="92dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_checkin_drag_handle" />

            <TextView
                android:id="@+id/tvWorkoutSheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:includeFontPadding="false"
                android:text="训练打卡"
                android:textColor="#111827"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="快速记录动作、训练量和体感"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#101418"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_checkin_summary_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="当前动作"
                            android:textColor="#10C7B5"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSheetCurrentExercise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="训练动作"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSheetCurrentPart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="固定器械"
                            android:textColor="#D1D5DB"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvSheetSuggestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="建议：3 组 × 12 次"
                            android:textColor="#10C7B5"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_checkin_summary_icon"
                        android:padding="13dp"
                        android:src="@drawable/ic_checkin_dumbbell"
                        android:tint="#10C7B5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#EEF0F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="基础信息"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="3dp"
                            android:src="@drawable/ic_checkin_dumbbell"
                            android:tint="#10C7B5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="动作名称"
                            android:textColor="#6B7280"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" *"
                            android:textColor="#EF4444"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acSheetExercise"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:completionThreshold="1"
                            android:ellipsize="end"
                            android:gravity="end|center_vertical"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:singleLine="true"
                            android:textColor="#111827"
                            android:textColorHint="#9CA3AF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEF0F3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="3dp"
                            android:src="@drawable/ic_checkin_body"
                            android:tint="#10C7B5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="训练部位"
                            android:textColor="#6B7280"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acSheetBodyPart"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:completionThreshold="1"
                            android:ellipsize="end"
                            android:gravity="end|center_vertical"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:singleLine="true"
                            android:textColor="#111827"
                            android:textColorHint="#9CA3AF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#EEF0F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="训练数据"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include layout="@layout/view_checkin_metric_sets" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <include layout="@layout/view_checkin_metric_reps" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include layout="@layout/view_checkin_metric_weight" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <include layout="@layout/view_checkin_metric_duration" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#EEF0F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="训练感受 *"
                        android:textColor="#111827"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/rgSheetFeeling"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingHorizontal="10dp"
                        app:singleLine="false"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/rbSheetEasy"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minHeight="36dp"
                            android:text="轻松"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/checkin_feeling_bg"
                            app:chipCornerRadius="18dp"
                            app:chipMinHeight="36dp"
                            app:chipStartPadding="18dp"
                            app:chipEndPadding="18dp"
                            app:ensureMinTouchTargetSize="false"
                            app:rippleColor="#3310C7B5"
                            app:chipStrokeColor="@color/checkin_feeling_stroke"
                            app:chipStrokeWidth="1dp"
                            android:textColor="@color/checkin_feeling_text" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/rbSheetModerate"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:checked="true"
                            android:minHeight="36dp"
                            android:text="适中"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/checkin_feeling_bg"
                            app:chipCornerRadius="18dp"
                            app:chipMinHeight="36dp"
                            app:chipStartPadding="18dp"
                            app:chipEndPadding="18dp"
                            app:ensureMinTouchTargetSize="false"
                            app:rippleColor="#3310C7B5"
                            app:chipStrokeColor="@color/checkin_feeling_stroke"
                            app:chipStrokeWidth="1dp"
                            android:textColor="@color/checkin_feeling_text" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/rbSheetHard"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minHeight="36dp"
                            android:text="困难"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/checkin_feeling_bg"
                            app:chipCornerRadius="18dp"
                            app:chipMinHeight="36dp"
                            app:chipStartPadding="18dp"
                            app:chipEndPadding="18dp"
                            app:ensureMinTouchTargetSize="false"
                            app:rippleColor="#3310C7B5"
                            app:chipStrokeColor="@color/checkin_feeling_stroke"
                            app:chipStrokeWidth="1dp"
                            android:textColor="@color/checkin_feeling_text" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#EEF0F3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="训练备注（可选）"
                        android:textColor="#111827"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_checkin_input">

                        <EditText
                            android:id="@+id/etSheetNote"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:gravity="top|start"
                            android:hint="记录今天的状态、疲劳感或训练反馈"
                            android:inputType="textMultiLine"
                            android:maxLength="200"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="22dp"
                            android:textColor="#111827"
                            android:textColorHint="#9CA3AF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|bottom"
                            android:layout_marginEnd="14dp"
                            android:layout_marginBottom="10dp"
                            android:text="0/200"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="bottom"
        android:background="#F6F8FA"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetSubmit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:minHeight="52dp"
            android:text="提交打卡"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#10C7B5"
            app:cornerRadius="18dp"
            app:elevation="0dp" />
    </LinearLayout>
</FrameLayout>
