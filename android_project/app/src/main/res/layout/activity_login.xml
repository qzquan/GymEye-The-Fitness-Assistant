<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gymeye_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/gymeye_gym_hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC080B0F"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/scrollAuthWelcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/gymeye_page_margin_horizontal"
            android:paddingTop="@dimen/gymeye_space_32"
            android:paddingEnd="@dimen/gymeye_page_margin_horizontal"
            android:paddingBottom="@dimen/gymeye_space_32">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gymeye_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="@dimen/gymeye_space_24">

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="GymEye"
                    android:textColor="@color/gymeye_text_primary"
                    android:textSize="@dimen/gymeye_text_display"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTagline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_4"
                    android:gravity="center"
                    android:text="AI 健身助手，识别器械，科学训练"
                    android:textColor="@color/gymeye_text_secondary"
                    android:textSize="@dimen/gymeye_text_body" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_24"
                    android:columnCount="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="104dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="@dimen/gymeye_space_8"
                        android:background="@drawable/bg_auth_feature_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/gymeye_space_8">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_auth_feature_icon"
                            android:gravity="center"
                            android:text="AI"
                            android:textColor="@color/gymeye_on_accent"
                            android:textSize="@dimen/gymeye_text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gymeye_space_8"
                            android:gravity="center"
                            android:text="器械识别"
                            android:textColor="@color/gymeye_text_primary"
                            android:textSize="@dimen/gymeye_text_label"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="104dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="@dimen/gymeye_space_4"
                        android:layout_marginEnd="@dimen/gymeye_space_4"
                        android:background="@drawable/bg_auth_feature_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/gymeye_space_8">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_auth_feature_icon"
                            android:gravity="center"
                            android:text="GO"
                            android:textColor="@color/gymeye_on_accent"
                            android:textSize="@dimen/gymeye_text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gymeye_space_8"
                            android:gravity="center"
                            android:text="动作指导"
                            android:textColor="@color/gymeye_text_primary"
                            android:textSize="@dimen/gymeye_text_label"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="104dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="@dimen/gymeye_space_8"
                        android:background="@drawable/bg_auth_feature_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/gymeye_space_8">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_auth_feature_icon"
                            android:gravity="center"
                            android:text="LOG"
                            android:textColor="@color/gymeye_on_accent"
                            android:textSize="@dimen/gymeye_text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gymeye_space_8"
                            android:gravity="center"
                            android:text="训练记录"
                            android:textColor="@color/gymeye_text_primary"
                            android:textSize="@dimen/gymeye_text_label"
                            android:textStyle="bold" />
                    </LinearLayout>
                </GridLayout>

                <LinearLayout
                    android:id="@+id/layoutSavedAccountsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_20"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSavedAccountsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="最近登录账号"
                        android:textColor="@color/gymeye_text_primary"
                        android:textSize="@dimen/gymeye_text_label"
                        android:textStyle="bold" />

                    <ScrollView
                        android:id="@+id/svSavedAccounts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_8"
                        android:fillViewport="false"
                        android:maxHeight="144dp"
                        android:overScrollMode="ifContentScrolls"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/llSavedAccounts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogIn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gymeye_button_height"
                    android:layout_marginTop="@dimen/gymeye_space_24"
                    android:text="登录账号"
                    android:textAllCaps="false"
                    android:textColor="@color/gymeye_on_primary"
                    android:textSize="@dimen/gymeye_text_body"
                    android:textStyle="bold"
                    app:backgroundTint="@color/gymeye_primary"
                    app:cornerRadius="@dimen/gymeye_radius_button"
                    app:elevation="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignUp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gymeye_button_height"
                    android:layout_marginTop="@dimen/gymeye_space_12"
                    android:text="注册新账号"
                    android:textAllCaps="false"
                    android:textColor="@color/gymeye_primary"
                    android:textSize="@dimen/gymeye_text_body"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/gymeye_radius_button"
                    app:strokeColor="@color/gymeye_border"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/tvGuest"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gymeye_button_height"
                    android:layout_marginTop="@dimen/gymeye_space_12"
                    android:background="@drawable/bg_auth_text_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="游客体验"
                    android:textColor="@color/gymeye_accent_dark"
                    android:textSize="@dimen/gymeye_text_body"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutRegisterPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gymeye_space_20"
                    android:background="@drawable/bg_auth_register_panel"
                    android:orientation="vertical"
                    android:padding="@dimen/gymeye_space_16"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCreateAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="创建新账户"
                        android:textColor="@color/gymeye_text_primary"
                        android:textSize="@dimen/gymeye_text_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gymeye_space_4"
                        android:text="注册后可保存识别记录和训练进度。"
                        android:textColor="@color/gymeye_text_muted"
                        android:textSize="@dimen/gymeye_text_label" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="@dimen/gymeye_space_16">

                        <EditText
                            android:id="@+id/etUsername"
                            style="@style/LoginInputField"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_gymeye_input_selector"
                            android:gravity="center_vertical"
                            android:inputType="textPersonName"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:singleLine="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|top"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/gymeye_card"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="用户名"
                            android:textColor="@color/gymeye_text_primary"
                            android:textSize="@dimen/gymeye_text_label" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="@dimen/gymeye_space_8">

                        <EditText
                            android:id="@+id/etEmail"
                            style="@style/LoginInputField"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_gymeye_input_selector"
                            android:gravity="center_vertical"
                            android:inputType="textEmailAddress"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:singleLine="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|top"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/gymeye_card"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="邮箱"
                            android:textColor="@color/gymeye_text_primary"
                            android:textSize="@dimen/gymeye_text_label" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="@dimen/gymeye_space_8">

                        <EditText
                            android:id="@+id/etPassword"
                            style="@style/LoginInputField"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_gymeye_input_selector"
                            android:gravity="center_vertical"
                            android:inputType="textPassword"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:singleLine="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|top"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/gymeye_card"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="密码"
                            android:textColor="@color/gymeye_text_primary"
                            android:textSize="@dimen/gymeye_text_label" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="@dimen/gymeye_space_8">

                        <EditText
                            android:id="@+id/etConfirm"
                            style="@style/LoginInputField"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_gymeye_input_selector"
                            android:gravity="center_vertical"
                            android:inputType="textPassword"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:singleLine="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|top"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/gymeye_card"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="确认密码"
                            android:textColor="@color/gymeye_text_primary"
                            android:textSize="@dimen/gymeye_text_label" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegisterSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/gymeye_button_height"
                        android:layout_marginTop="@dimen/gymeye_space_16"
                        android:text="完成注册"
                        android:textAllCaps="false"
                        android:textColor="@color/gymeye_on_primary"
                        android:textSize="@dimen/gymeye_text_body"
                        android:textStyle="bold"
                        app:backgroundTint="@color/gymeye_primary"
                        app:cornerRadius="@dimen/gymeye_radius_button"
                        app:elevation="1dp" />

                    <TextView
                        android:id="@+id/tvCancelRegister"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/gymeye_touch_target"
                        android:layout_marginTop="@dimen/gymeye_space_8"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="收起注册表单"
                        android:textColor="@color/gymeye_text_secondary"
                        android:textSize="@dimen/gymeye_text_label"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
