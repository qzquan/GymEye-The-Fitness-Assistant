<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F5F5"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF2196F3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/tvEquipmentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="倒蹬机" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- 可滚动内容区域 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 视频播放区域 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_margin="16dp"
                android:background="@drawable/video_player_background"
                android:elevation="4dp">

                <VideoView
                    android:id="@+id/videoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <!-- 视频加载占位符 -->
                <TextView
                    android:id="@+id/tvVideoPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="视频加载中..."
                    android:textColor="#FF666666"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <!-- 重新播放按钮 -->
                <ImageButton
                    android:id="@+id/btnReplay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="12dp"
                    android:background="@drawable/circle_button_background"
                    android:contentDescription="重新播放"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    app:tint="#FFFFFFFF" />
            </FrameLayout>

            <!-- 肌肉发力图标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="肌肉发力图"
                android:textColor="#FF333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 肌肉图展示区域 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_margin="16dp"
                android:elevation="4dp"
                app:cardCornerRadius="12dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <com.example.strong_body.MuscleView
                    android:id="@+id/muscleView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFFFF" />

            </androidx.cardview.widget.CardView>

            <!-- 肌肉群文字说明 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPrimaryMuscles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="#FFFF4444"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="主要锻炼: 股四头肌、臀大肌" />

                <TextView
                    android:id="@+id/tvSecondaryMuscles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFF8800"
                    android:textSize="14sp"
                    tools:text="辅助锻炼: 腘绳肌、小腿肌群" />
            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#FFE0E0E0" />

            <!-- 器材描述 -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#FF555555"
                android:textSize="15sp"
                tools:text="倒蹬机是锻炼下肢力量的经典器械，主要针对大腿前侧股四头肌和臀部肌群。" />

            <!-- 难度标签 -->
            <TextView
                android:id="@+id/tvDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/difficulty_badge_background"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                tools:text="难度: 中级" />

            <!-- 使用技巧标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="使用技巧"
                android:textColor="#FF333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 使用技巧内容 -->
            <TextView
                android:id="@+id/tvTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="#FFF0F7FF"
                android:lineSpacingExtra="6dp"
                android:padding="16dp"
                android:textColor="#FF444444"
                android:textSize="14sp"
                tools:text="1. 脚距与肩同宽\n2. 下放时膝盖不超过脚尖\n3. 不要完全锁死关节" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
