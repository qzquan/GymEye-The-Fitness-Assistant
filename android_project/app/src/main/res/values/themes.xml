<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Strong_body" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Window settings for full screen -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- 引用 @font/font_family（Roboto 600，需 GMS 下载）；无 GMS 时用 SemiboldSystem -->
    <style name="TextAppearance.GymEye.Semibold" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/font_family</item>
        <item name="android:fontFamily">@font/font_family</item>
    </style>

    <style name="TextAppearance.GymEye.SemiboldSystem" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
</resources>
